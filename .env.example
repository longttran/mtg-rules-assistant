# Copy to .env (never commit .env)
AWS_REGION=us-west-2
# Copy the exact model or inference-profile ID for a Claude model from the
# Bedrock console > Model catalog (make sure model access is enabled first).
BEDROCK_MODEL_ID=
# Credentials: use `aws configure` / AWS SSO rather than putting keys here.

BEDROCK_KB_ID=   # Bedrock Knowledge Base ID for Comprehensive Rules RAG
